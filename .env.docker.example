# Copia este archivo como .env.docker y cámbialo si hace falta.
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d --build
#   docker compose --env-file .env.docker --profile init run --rm admin
#
# Todos los valores tienen un valor por defecto en docker-compose.yml:
# si no creas .env.docker, la aplicación igual arranca.

# --- Puertos en tu equipo ---
FRONTEND_PORT=3000
BACKEND_PORT=8000

# URL que usa el NAVEGADOR para llamar al backend.
# Si abres la app desde otro equipo de la red, usa la IP de este equipo:
#   NEXT_PUBLIC_API_URL=http://192.168.1.50:8000
# Si la cambias, hay que reconstruir: docker compose build frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Base de datos PostgreSQL local ---
# No se publica fuera de Docker; solo la usa el backend.
POSTGRES_USER=bell
POSTGRES_PASSWORD=bell_local_password
POSTGRES_DB=bell

# --- Seguridad ---
# Clave para firmar las sesiones. Usa una larga y única.
JWT_SECRET_KEY=cambia-esta-clave-por-una-larga-y-unica

# --- Primer super_admin ---
# Se crea/actualiza con el comando --profile init.
# La contraseña debe tener al menos 8 caracteres.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@inventario.local
ADMIN_PASSWORD=

# --- Asistente con IA (opcional) ---
# Sin IA_API_KEY el inventario, la tienda y los reportes funcionan igual;
# solo el chat de lenguaje natural queda sin respuesta.
IA_BASE_URL=https://openrouter.ai/api/v1
IA_API_KEY=
IA_MODEL=openrouter/free
IA_FALLBACK_MODELS=liquid/lfm-2.5-2.6b:free,nvidia/nemotron-3.5-lightning:free
IA_TIMEOUT=20
