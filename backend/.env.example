# Configuración de la base de datos
# Opción A: SQLite (solo desarrollo local)
# DATABASE_URL=sqlite:///inventario.db

# Opción B: Supabase PostgreSQL con connection pooler (recomendado para producción)
# Usando pg8000 (driver puro Python, sin dependencias de C/libpq)
# DATABASE_URL=postgresql+pg8000://postgres.xxx:TU_PASSWORD@aws-0-xxx.pooler.supabase.com:6543/postgres?pgbouncer=true

# --- Asistente IA (proveedor compatible con la API de OpenAI) ---
# Recomendado: OpenRouter (https://openrouter.ai/keys) por su disponibilidad y modelos gratis
IA_BASE_URL=https://openrouter.ai/api/v1
IA_API_KEY=TU_CLAVE_DE_OPENROUTER_AQUI
IA_MODEL=openrouter/free
# Modelos alternativos si el principal falla o tarda demasiado (separados por coma)
IA_FALLBACK_MODELS=liquid/lfm-2.5-2.6b:free,nvidia/nemotron-3.5-lightning:free
# Segundos máximos de espera por modelo antes de pasar al siguiente
IA_TIMEOUT=20

# Alternativas (cambia IA_BASE_URL, IA_API_KEY e IA_MODEL):
#   Groq:     https://api.groq.com/openai/v1        | openai/gpt-oss-120b
#   Mistral:  https://api.mistral.ai/v1             | mistral-small-latest
#   DeepSeek: https://api.deepseek.com/v1           | deepseek-chat
#   Ollama:   http://localhost:11434/v1             | qwen2.5:3b (api key cualquiera)

# Puerto del servidor
PORT=8000

# Clave secreta para JWT (mínimo 32 caracteres, cámbiala en producción)
JWT_SECRET_KEY=CAMBIA_POR_UNA_CLAVE_LARGA_Y_UNICA
